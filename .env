# MQTT
MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883
MQTT_TOPIC_RAW=iiot/raw
MQTT_TOPIC_EDGE=iiot/edge
MQTT_CLIENT_ID=mqtt-consumer
ALERT_RISK_THRESHOLD=0.3
LOG_LEVEL=INFO

# Simulator
SIMULATOR_CSV_PATH=data/simulation_input.csv
SIMULATOR_INTERVAL=1.0
SIMULATOR_SCENARIO=normal_run

# Edge
EDGE_MODEL_PATH=/app/models/edge_model.pkl
EDGE_NORMALIZATION_CONFIG_PATH=app/config/training_fallback.json

# Cloud
MODEL_PATH=/app/app/models/ml/cloud_model.json
FEATURE_LIST_PATH=/app/app/models/ml/cloud_feature_list.json
NORMALIZATION_CONFIG_PATH=/app/app/models/ml/cloud_normalization_config.json
SHAP_BACKGROUND_SAMPLE_PATH=/app/app/models/ml/shap_background_sample.pkl

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=predictive_db
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin

INFLUX_URL=http://influxdb:8086
INFLUX_TOKEN=my-super-token
INFLUX_ORG=iiot-org
INFLUX_BUCKET=iiot-bucket

DATABASE_URL=postgresql://admin:admin@postgres:5432/predictive_db
JWT_SECRET_KEY=supersecretkey
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

CLOUD_API_URL: http://dashboard_api:8000/api/v1/cloud/predict
CLOUD_API_TIMEOUT: 5
ENABLE_CLOUD_PREDICTION: "true"